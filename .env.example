# ==============================================================================
# EDUSMK LMS - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================

# Supabase Project URL & Anonymous Public Key
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Optional) Supabase Service Role Key - HANYA untuk backend / server side scripts
# JANGAN PERNAH MENGEKSPOS KEY INI KE BROWSER ATAU MENGGUNAKAN PREFIX NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Base URL Aplikasi (digunakan untuk absolute URL di production)
NEXT_PUBLIC_APP_URL=https://edusmk.vercel.app
